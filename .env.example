# Copy to .env and adjust. Everything runs locally; no API keys.

# Which agent to run: a folder under profiles/ (uow_india, acme_fiber, ...)
PROFILE=uow_india
# Optional overrides of the profile's profile.json:
# AGENT_NAME=Maya
# COMPANY_NAME=the University of Wollongong in India
# DATA_DIR=./profiles/uow_india/knowledge

# Speech-to-text: whisper (tiny.en | base.en | small.en) or vosk
# small.en handles Indian-accented English better, if your CPU is fast enough.
STT_ENGINE=whisper
WHISPER_MODEL=base.en

# Local LLM via Ollama (https://ollama.com): `ollama pull llama3.2:3b`
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Text-to-speech: piper (natural) or espeak (robotic, no download)
TTS_ENGINE=piper
PIPER_VOICE=./models/piper/en_US-lessac-medium.onnx
SPEECH_RATE=1.0

# Turn-taking
BARGE_IN=true
END_OF_TURN_MS=700
